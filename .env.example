# ===============================================
# Nexa Global Market - Environment Variables
# ===============================================

# -----------------------------------------------
# Supabase Configuration
# -----------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# -----------------------------------------------
# Provider-Agnostic AI Backend Configuration
# -----------------------------------------------
# Active provider: "gemini" | "openai" | "claude" (defaults to "gemini")
AI_PROVIDER=gemini

# Google Gemini (Active default)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# OpenAI / ChatGPT (Optional - for switching providers)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude (Optional - for switching providers)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
